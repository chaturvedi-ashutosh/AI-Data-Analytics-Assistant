PORT=3000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Application connection. Use the read-only analytics_user role.
DATABASE_URL=postgresql://analytics_user:replace_me@localhost:5432/analytics_db
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000
ANALYTICS_DB_ROLE=analytics_user
ANALYTICS_QUERY_TIMEOUT_MS=5000
ANALYTICS_MAX_ROWS=500

# Local Ollama inference
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
# Optional full override for the default system prompt
# ANALYTICS_SYSTEM_PROMPT=
